{
    "name": "ndate22/laravel-ndate",
    "description": "Laravel integration for ndate22/ndate (Nepali BS/AD date converter)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kamal Pandey",
            "email": "kml.pandey77@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "ndate22/ndate": "^0.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "pestphp/pest": "^2.33 || ^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ndate22/ndate"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ndate22\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ndate22\\Laravel\\NdateServiceProvider"
            ],
            "aliases": {
                "Ndate": "Ndate22\\Laravel\\Facades\\Ndate"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
